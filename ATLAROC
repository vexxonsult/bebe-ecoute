<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ATLAROC — Planche logo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,800;1,800&family=Anton&family=Bebas+Neue&family=Chakra+Petch:ital,wght@0,600;0,700;1,700&family=Saira+Condensed:ital,wght@0,800;1,800&family=Rajdhani:wght@600;700&family=Michroma&family=Oswald:wght@600;700&family=Space+Grotesk:wght@700&family=Russo+One&family=Black+Ops+One&family=Syncopate:wght@700&family=Teko:wght@700&family=Exo+2:ital,wght@1,800&family=Zen+Dots&family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --amber:#E5541E; --kaki:#7C7A3A;
    --stage:#F4F1E9; --ink:#16160F; --edge:rgba(0,0,0,.08); --accent:#E5541E;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:#101b1a;
    background-image:radial-gradient(1100px 560px at 82% -12%,#1a302d 0,transparent 60%);
    color:#eef0e9;font-family:"Inter",system-ui,sans-serif;-webkit-font-smoothing:antialiased;}
  .wrap{max-width:1280px;margin:0 auto;padding:30px 20px 70px;}

  /* header */
  .eyebrow{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--amber);font-weight:600;}
  h1{font-family:"Archivo",sans-serif;font-weight:800;font-size:clamp(24px,4vw,36px);letter-spacing:-.02em;margin:8px 0 6px;color:#fff;}
  .lead{color:#b7c2bb;font-size:14.5px;max-width:64ch;line-height:1.55;}

  /* toolbar */
  .toolbar{position:sticky;top:0;z-index:20;margin:22px 0 26px;padding:14px;border:1px solid #294240;border-radius:16px;
    background:rgba(14,26,25,.86);backdrop-filter:blur(10px);display:flex;flex-wrap:wrap;gap:18px 26px;align-items:flex-end;}
  .ctrl{display:flex;flex-direction:column;gap:7px;}
  .ctrl>label{font-family:"IBM Plex Mono",monospace;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:#8ba09a;}
  .seg{display:inline-flex;background:#0e1a19;border:1px solid #2b4340;border-radius:10px;padding:3px;gap:2px;}
  .seg button{font-family:"IBM Plex Mono",monospace;font-size:12px;color:#a9b8b2;background:transparent;border:0;padding:7px 12px;border-radius:7px;cursor:pointer;transition:.15s;white-space:nowrap;}
  .seg button:hover{color:#fff;}
  .seg button[aria-pressed="true"]{background:var(--amber);color:#120a06;font-weight:600;}
  .seg.k button[aria-pressed="true"]{background:var(--kaki);color:#12130a;}
  .namebox{display:flex;flex-direction:column;gap:7px;}
  .namebox input{font-family:"IBM Plex Mono",monospace;font-size:14px;letter-spacing:2px;text-transform:uppercase;
    background:#0e1a19;border:1px solid #2b4340;color:#fff;border-radius:10px;padding:8px 12px;width:170px;}
  .namebox input:focus{outline:2px solid var(--amber);outline-offset:1px;}
  .fav-ct{margin-left:auto;font-family:"IBM Plex Mono",monospace;font-size:12px;color:#a9b8b2;display:flex;align-items:center;gap:12px;}
  .fav-ct b{color:var(--amber);}
  .fav-ct button{font-family:"IBM Plex Mono",monospace;font-size:11px;color:#a9b8b2;background:#0e1a19;border:1px solid #2b4340;border-radius:8px;padding:7px 11px;cursor:pointer;}
  .fav-ct button[aria-pressed="true"]{border-color:var(--amber);color:var(--amber);}

  /* grid */
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;}
  .card{border:1px solid #223c3a;border-radius:14px;overflow:hidden;background:#0f1c1b;display:flex;flex-direction:column;transition:.18s;}
  .card.fav{border-color:var(--amber);box-shadow:0 0 0 1px var(--amber);}
  .card.hide{display:none;}
  .stage{min-height:150px;display:flex;align-items:center;justify-content:center;padding:26px 22px;
    background:var(--stage);border-bottom:1px solid var(--edge);transition:background .25s;}
  .meta{padding:12px 14px;display:flex;align-items:flex-start;gap:10px;}
  .meta .txt{flex:1;min-width:0;}
  .idx{font-family:"IBM Plex Mono",monospace;font-size:11px;color:var(--amber);font-weight:600;}
  .name{font-family:"Archivo",sans-serif;font-weight:700;font-size:14px;color:#f2f4ee;margin-top:1px;}
  .note{font-size:12px;color:#93a29c;line-height:1.45;margin-top:3px;}
  .star{flex:0 0 auto;width:34px;height:34px;border-radius:9px;border:1px solid #2b4340;background:#0e1a19;
    color:#8ba09a;cursor:pointer;font-size:16px;line-height:1;display:flex;align-items:center;justify-content:center;transition:.15s;}
  .star:hover{color:#fff;border-color:#3f5b58;}
  .card.fav .star{color:var(--amber);border-color:var(--amber);}

  /* logo primitives */
  .wm{color:var(--ink);line-height:.9;display:inline-flex;align-items:center;white-space:nowrap;transition:color .25s;}
  .lock{display:flex;align-items:center;gap:14px;color:var(--ink);transition:color .25s;}
  .lock.stacked{flex-direction:column;gap:9px;}
  .mark{color:var(--ink);flex:0 0 auto;}
  .mark .ac{color:var(--accent);transition:color .25s;}
  .wm .ac{color:var(--accent);}
  .baseline{font-family:"IBM Plex Mono",monospace;font-size:9px;letter-spacing:3.5px;color:var(--ink);opacity:.75;}
  .divider{color:var(--accent);}

  footer{margin-top:34px;text-align:center;font-family:"IBM Plex Mono",monospace;font-size:11px;color:#5c6b60;letter-spacing:.4px;}
  @media (max-width:560px){.wrap{padding:20px 13px 50px;}.namebox input{width:140px;}.grid{grid-template-columns:1fr;}}
  @media (prefers-reduced-motion:reduce){*{transition:none!important;}}
</style>
</head>
<body>
<div class="wrap">
  <div class="eyebrow">Planche de décision · Identité de marque</div>
  <h1>ATLAROC — 22 pistes de logo</h1>
  <p class="lead">Wordmarks, lockups avec symbole et déclinaisons dynamiques, dans l'esprit du brief : outdoor robuste, minéral, sérieux. Teste chaque piste sur différents fonds et accents, puis mets en favori celles à retenir.</p>

  <div class="toolbar">
    <div class="namebox">
      <label for="nm">Nom</label>
      <input id="nm" value="ATLAROC" spellcheck="false" autocomplete="off">
    </div>
    <div class="ctrl">
      <label>Fond</label>
      <div class="seg" id="bg">
        <button data-bg="light" aria-pressed="true">Clair</button>
        <button data-bg="dark">Sombre</button>
        <button data-bg="kaki">Kaki</button>
        <button data-bg="sand">Sable</button>
      </div>
    </div>
    <div class="ctrl">
      <label>Accent</label>
      <div class="seg k" id="ac">
        <button data-ac="mono" aria-pressed="true">Mono</button>
        <button data-ac="orange">Orange</button>
        <button data-ac="kaki">Kaki</button>
      </div>
    </div>
    <div class="fav-ct">
      <span><b id="favn">0</b> favori(s)</span>
      <button id="onlyfav" aria-pressed="false">Voir la sélection</button>
    </div>
  </div>

  <div class="grid" id="grid"></div>
  <footer>ATLAROC · planche exploratoire — brouillon, à affiner en vectoriel une fois la piste choisie</footer>
</div>

<script>
(function(){
  var NAME = "ATLAROC";

  // ---- icon marks (scale via height) ----
  function mtn(h){h=h||58;return '<svg class="mark" width="'+h+'" height="'+h+'" viewBox="0 0 64 64" fill="none">'+
    '<path d="M3 55 L24 15 L34 33 L41 22 L61 55 Z" fill="currentColor"/>'+
    '<path d="M24 15 L30.5 27.4 L27 30 L20.5 22 Z" class="ac" fill="currentColor"/>'+
    '<path d="M14 55 C 22 46, 42 46, 50 55" stroke="currentColor" stroke-width="2" opacity=".28"/></svg>';}
  function rock(h){h=h||58;return '<svg class="mark" width="'+h+'" height="'+h+'" viewBox="0 0 64 64" fill="none">'+
    '<path d="M8 40 L22 16 L44 14 L58 34 L48 56 L18 56 Z" fill="currentColor"/>'+
    '<path d="M22 16 L34 34 L18 56 M44 14 L34 34 L48 56 M34 34 L58 34 M34 34 L8 40" stroke="#0f1c1b" stroke-width="1.5" opacity=".35"/>'+
    '<path d="M22 16 L34 34 L44 14 Z" class="ac" fill="currentColor"/></svg>';}
  function hexShield(inner,h){h=h||60;return '<svg class="mark" width="'+h+'" height="'+h+'" viewBox="0 0 64 64" fill="none">'+
    '<path d="M32 4 L56 17 L56 43 L32 60 L8 43 L8 17 Z" stroke="currentColor" stroke-width="3" fill="none"/>'+
    '<path d="M32 4 L56 17 L45 23 L21 23 L8 17 Z" class="ac" fill="currentColor" opacity=".9"/>'+
    (inner||'')+'</svg>';}
  function compass(h){h=h||46;return '<svg width="'+h+'" height="'+h+'" viewBox="0 0 64 64" fill="none" style="vertical-align:middle;margin:0 -2px;">'+
    '<circle cx="32" cy="32" r="28" stroke="currentColor" stroke-width="5" fill="none"/>'+
    '<path d="M32 14 L38 32 L32 50 L26 32 Z" fill="currentColor"/>'+
    '<path d="M32 14 L38 32 L32 32 Z" class="ac" fill="currentColor"/>'+
    '<circle cx="32" cy="32" r="3.4" fill="#0f1c1b"/></svg>';}
  function contour(h){h=h||58;return '<svg class="mark" width="'+h+'" height="'+h+'" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4">'+
    '<path d="M10 44 C 20 30, 44 30, 54 44"/>'+
    '<path d="M14 50 C 24 38, 40 38, 50 50" opacity=".7"/>'+
    '<path d="M18 37 C 26 27, 38 27, 46 37" class="ac"/>'+
    '<circle cx="32" cy="28" r="3.2" fill="currentColor" stroke="none"/></svg>';}
  function carab(h){h=h||58;return '<svg class="mark" width="'+h+'" height="'+h+'" viewBox="0 0 64 64" fill="none">'+
    '<rect x="14" y="8" width="30" height="48" rx="15" stroke="currentColor" stroke-width="6" fill="none"/>'+
    '<path d="M44 20 L44 44" stroke="currentColor" stroke-width="6"/>'+
    '<path d="M29 8 L44 20" class="ac" stroke="currentColor" stroke-width="6"/></svg>';}
  function bolt(h){h=h||58;return '<svg class="mark" width="'+h+'" height="'+h+'" viewBox="0 0 64 64" fill="none">'+
    '<path d="M36 4 L14 36 L30 36 L26 60 L50 26 L34 26 Z" fill="currentColor"/>'+
    '<path d="M36 4 L14 36 L26 36 Z" class="ac" fill="currentColor"/></svg>';}
  function emblem(){var t=NAME+" • AUTONOMIE OUTDOOR • ";return '<svg class="mark" width="120" height="120" viewBox="0 0 120 120">'+
    '<defs><path id="cp" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>'+
    '<circle cx="60" cy="60" r="56" fill="none" stroke="currentColor" stroke-width="2.5"/>'+
    '<circle cx="60" cy="60" r="35" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".4"/>'+
    '<text font-family="IBM Plex Mono, monospace" font-size="10.4" font-weight="600" letter-spacing="1.6" fill="currentColor"><textPath href="#cp" startOffset="0">'+t+'</textPath></text>'+
    '<path d="M42 70 L57 44 L64 56 L69 48 L80 70 Z" fill="currentColor"/>'+
    '<path d="M57 44 L61.5 52 L58 55 L53.5 48 Z" class="ac" fill="currentColor"/></svg>';}
  function monogram(){var m=(NAME.replace(/[^A-Za-z]/g,'').slice(0,2)||"AR").toUpperCase();
    return '<svg class="mark" width="76" height="76" viewBox="0 0 76 76" fill="none">'+
    '<path d="M38 4 L66 20 L66 56 L38 72 L10 56 L10 20 Z" stroke="currentColor" stroke-width="3.4" fill="none"/>'+
    '<path d="M38 4 L66 20 L38 36 L10 20 Z" class="ac" fill="currentColor" opacity=".9"/>'+
    '<text x="38" y="55" text-anchor="middle" font-family="Archivo, sans-serif" font-weight="800" font-size="26" fill="currentColor" style="font-style:italic">'+m+'</text></svg>';}

  // wordmark helper
  function W(font,style){return '<span class="wm" style="font-family:\''+font+'\';'+(style||'')+'">'+NAME+'</span>';}
  // wordmark with the first O replaced by a compass svg
  function Wcompass(font,style){
    var up=NAME.toUpperCase(), i=up.indexOf('O');
    var inner = i>=0
      ? '<span>'+NAME.slice(0,i)+'</span>'+compass(44)+'<span>'+NAME.slice(i+1)+'</span>'
      : compass(44)+'<span>'+NAME+'</span>';
    return '<span class="wm" style="font-family:\''+font+'\';'+(style||'')+'">'+inner+'</span>';
  }

  // ---- 22 concepts ----
  function concepts(){return [
    {id:'oblique', name:'Oblique Bold', note:"Ta direction actuelle, affinée — grotesque gras penché, énergie et vitesse.",
      html:function(){return W('Archivo','font-style:italic;font-size:44px;letter-spacing:-.5px;');}},
    {id:'condense', name:'Condensé Haut', note:"Vertical et élancé, très lisible en petit — bon pour l'étiquette produit.",
      html:function(){return W('Bebas Neue','font-size:56px;letter-spacing:6px;');}},
    {id:'bloc', name:'Bloc Massif', note:"Ultra-dense, impact maximal — le mot devient un objet plein.",
      html:function(){return W('Anton','font-size:48px;letter-spacing:.5px;');}},
    {id:'tech', name:'Tech Anguleux', note:"Coupes nettes façon instrument — côté outil fiable, technique.",
      html:function(){return W('Chakra Petch','font-weight:700;font-size:42px;letter-spacing:1px;');}},
    {id:'sport', name:'Sport Dynamique', note:"Condensé italique — mouvement, performance, terrain.",
      html:function(){return W('Saira Condensed','font-style:italic;font-weight:800;font-size:52px;letter-spacing:1px;');}},
    {id:'inge', name:'Ingénierie', note:"Fin, espacé, précis — registre premium/technique, moins agressif.",
      html:function(){return W('Rajdhani','font-weight:700;font-size:46px;letter-spacing:4px;');}},
    {id:'wide', name:'Large Technique', note:"Très espacé et carré — signature discrète, haut de gamme.",
      html:function(){return W('Michroma','font-size:26px;letter-spacing:4px;');}},
    {id:'slab', name:'Robuste Classique', note:"Valeur sûre outdoor — solide, chaleureux, intemporel.",
      html:function(){return W('Oswald','font-weight:700;font-size:44px;letter-spacing:2px;');}},
    {id:'geo', name:'Géométrique', note:"Moderne et neutre — laisse toute la place au symbole.",
      html:function(){return W('Space Grotesk','font-weight:700;font-size:42px;letter-spacing:-.5px;');}},
    {id:'brut', name:'Brutaliste', note:"Blocs pleins et arrondis — présence forte, presque industrielle.",
      html:function(){return W('Russo One','font-size:38px;letter-spacing:1px;');}},
    {id:'stencil', name:'Stencil Survie', note:"Pochoir militaire — registre prévention/urgence, à jouer en kaki.",
      html:function(){return '<span class="wm" style="font-family:\'Black Ops One\';font-size:36px;letter-spacing:2px;"><span class="ac">'+NAME.slice(0,4)+'</span>'+NAME.slice(4)+'</span>';}},
    {id:'wideprem', name:'Wide Premium', note:"Espacement maximal — sobre, cher, façon marque d'équipement sérieuse.",
      html:function(){return W('Syncopate','font-weight:700;font-size:24px;letter-spacing:6px;');}},

    {id:'sommet', name:'Sommet (A-montagne)', note:"Pic + neige + courbe de niveau — le symbole raconte la montagne.",
      html:function(){return '<div class="lock">'+mtn(60)+W('Archivo','font-style:italic;font-size:38px;letter-spacing:-.5px;')+'</div>';}},
    {id:'ecusson', name:'Écusson Hexagone', note:"Badge robuste — parfait pour cadeaux B2B, patchs, gravure.",
      html:function(){return '<div class="lock">'+hexShield('<path d="M22 42 L30 26 L35 34 L39 28 L46 42 Z" fill="#0f1c1b"/>',62)+W('Oswald','font-weight:700;font-size:34px;letter-spacing:2px;')+'</div>';}},
    {id:'boussole', name:'Boussole (O)', note:"Le O devient une rose des vents — orientation, autonomie.",
      html:function(){return Wcompass('Chakra Petch','font-weight:700;font-size:40px;letter-spacing:1px;');}},
    {id:'courbes', name:'Courbes de niveau', note:"Symbole topographique — carte, exploration, terrain.",
      html:function(){return '<div class="lock">'+contour(58)+W('Rajdhani','font-weight:700;font-size:42px;letter-spacing:3px;')+'</div>';}},
    {id:'roche', name:'Roche facettée', note:"Bloc minéral anguleux — solidité brute, le cœur du nom.",
      html:function(){return '<div class="lock">'+rock(58)+W('Archivo','font-style:italic;font-size:36px;letter-spacing:-.5px;')+'</div>';}},
    {id:'mousqueton', name:'Mousqueton', note:"Clin d'œil direct au produit — accroche, attache, fiabilité.",
      html:function(){return '<div class="lock">'+carab(56)+W('Saira Condensed','font-weight:800;font-size:46px;letter-spacing:1px;')+'</div>';}},
    {id:'eclair', name:'Éclair énergie', note:"Nod batterie/autonomie — l'énergie qui ne lâche pas.",
      html:function(){return '<div class="lock">'+bolt(56)+W('Exo 2','font-style:italic;font-weight:800;font-size:40px;letter-spacing:0;')+'</div>';}},
    {id:'stacked', name:'Lockup empilé + baseline', note:"Symbole + nom + signature — la version complète, site & packaging.",
      html:function(){return '<div class="lock stacked">'+mtn(50)+W('Oswald','font-weight:700;font-size:34px;letter-spacing:3px;')+'<span class="baseline">OUTDOOR POWER · AUTONOMIE</span></div>';}},
    {id:'emblem', name:'Emblème circulaire', note:"Tampon / bague de texte — pastille, étiquette, tête de série.",
      html:function(){return '<div class="lock">'+emblem()+'</div>';}},
    {id:'mono', name:'Monogramme AR', note:"Icône d'app / mark secondaire — se réduit sans perdre en force.",
      html:function(){return '<div class="lock">'+monogram()+W('Archivo','font-style:italic;font-size:30px;letter-spacing:-.5px;')+'</div>';}}
  ];}

  // ---- render ----
  var grid=document.getElementById('grid');
  var favs={}, onlyFav=false;
  function render(){
    var list=concepts(); grid.innerHTML='';
    list.forEach(function(c,i){
      var card=document.createElement('div');
      card.className='card'+(favs[c.id]?' fav':'')+((onlyFav&&!favs[c.id])?' hide':'');
      var n=('0'+(i+1)).slice(-2);
      card.innerHTML='<div class="stage">'+c.html()+'</div>'+
        '<div class="meta"><div class="txt"><div class="idx">'+n+'</div><div class="name">'+c.name+'</div><div class="note">'+c.note+'</div></div>'+
        '<button class="star" title="Mettre en favori" data-id="'+c.id+'">'+(favs[c.id]?'★':'☆')+'</button></div>';
      grid.appendChild(card);
    });
  }
  function updFav(){var k=Object.keys(favs).filter(function(x){return favs[x];});document.getElementById('favn').textContent=k.length;}

  grid.addEventListener('click',function(e){
    var b=e.target.closest('.star'); if(!b)return;
    var id=b.getAttribute('data-id'); favs[id]=!favs[id]; updFav(); render();
  });

  // name
  document.getElementById('nm').addEventListener('input',function(e){
    var v=e.target.value.trim(); NAME=v?v.toUpperCase():'ATLAROC'; render();
  });

  // background
  document.getElementById('bg').addEventListener('click',function(e){
    var b=e.target.closest('button'); if(!b)return;
    this.querySelectorAll('button').forEach(function(x){x.setAttribute('aria-pressed','false');});
    b.setAttribute('aria-pressed','true');
    var map={
      light:['#F4F1E9','#16160F','rgba(0,0,0,.08)'],
      dark:['#14201E','#EDE6D5','rgba(255,255,255,.09)'],
      kaki:['#4A4B36','#ECE7D6','rgba(255,255,255,.12)'],
      sand:['#D8C7A2','#2A2618','rgba(0,0,0,.10)']
    }, v=map[b.dataset.bg];
    document.documentElement.style.setProperty('--stage',v[0]);
    document.documentElement.style.setProperty('--ink',v[1]);
    document.documentElement.style.setProperty('--edge',v[2]);
  });

  // accent
  document.getElementById('ac').addEventListener('click',function(e){
    var b=e.target.closest('button'); if(!b)return;
    this.querySelectorAll('button').forEach(function(x){x.setAttribute('aria-pressed','false');});
    b.setAttribute('aria-pressed','true');
    var map={mono:'var(--ink)',orange:'#E5541E',kaki:'#7C7A3A'};
    document.documentElement.style.setProperty('--accent',map[b.dataset.ac]);
  });

  // only favorites
  document.getElementById('onlyfav').addEventListener('click',function(){
    onlyFav=!onlyFav; this.setAttribute('aria-pressed',onlyFav); render();
  });

  render();
})();
</script>
</body>
</html>
